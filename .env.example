# Telegram Bot Token (получить у @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# API ключ модели (OpenAI, OpenRouter, DeepSeek и др.)
OPENAI_API_KEY=your_openai_api_key_here

# Опционально: базовый URL для совместимых API (OpenRouter, DeepSeek, Ollama, vLLM)
# Для OpenAI оставьте пустым.
# Для OpenRouter: https://openrouter.ai/api/v1
# Для DeepSeek: https://api.deepseek.com
# Для локального Ollama: http://localhost:11434/v1
OPENAI_BASE_URL=

# Имя модели (например, gpt-4o-mini, gpt-4o, deepseek-chat, mistralai/mistral-large)
LLM_MODEL=gpt-4o-mini

# Максимальное количество сообщений в истории диалога для контекста
MAX_HISTORY_MESSAGES=10
